{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Dial Control",
  "version": "1.0.0",
  "identifier": "com.yuvraj.dialcontrol",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dial Control HUD",
        "label": "hud",
        "width": 500,
        "height": 500,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "shadow": false,
        "skipTaskbar": true,
        "url": "index.html?view=hud"
      },
      {
        "title": "Dial Control — Preferences",
        "label": "settings",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "visible": true,
        "center": true,
        "url": "index.html?view=settings"
      },
      {
        "title": "Dial Control Scroll Overlay",
        "label": "scroll_overlay",
        "fullscreen": true,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "url": "index.html?view=scroll_overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}

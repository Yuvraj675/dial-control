{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Dial Control",
  "version": "1.0.0",
  "identifier": "com.yuvraj.dialcontrol",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dial Control HUD",
        "label": "hud",
        "width": 500,
        "height": 500,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false,
        "center": true,
        "url": "index.html?view=hud"
      },
      {
        "title": "Dial Control — Preferences",
        "label": "settings",
        "width": 780,
        "height": 560,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "visible": false,
        "center": true,
        "url": "index.html?view=settings"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Dial Control — Active"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}

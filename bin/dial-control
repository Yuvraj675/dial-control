#!/usr/bin/env bash
# Dial Control Launcher
# Launches the commercial-grade native Rust + Tauri v2 desktop application.

APP_DIR="/home/yuvraj/Documents/Code_Projects/dial-control"
cd "$APP_DIR"

BINARY="$APP_DIR/src-tauri/target/debug/dial-control"
if [ -f "$APP_DIR/src-tauri/target/release/dial-control" ]; then
    BINARY="$APP_DIR/src-tauri/target/release/dial-control"
fi

# Ensure executable permissions
chmod +x "$BINARY" 2>/dev/null || true

exec "$BINARY" "$@"
